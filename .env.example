# Salin menjadi .env.local lalu isi dari Supabase: Project Settings > API
# Kunci "publishable"/"anon" memang aman untuk frontend (dilindungi Row Level Security).
# JANGAN PERNAH menaruh kunci "secret"/"service_role" di sini.
VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxx
